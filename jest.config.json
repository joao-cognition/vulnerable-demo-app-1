{
  "testEnvironment": "node",
  "transform": {
    "^.+\\.[jt]sx?$": "babel-jest"
  },
  "transformIgnorePatterns": [],
  "collectCoverageFrom": [
    "src/services/**/*.{js,ts}",
    "packages/app/src/**/*.js",
    "!**/node_modules/**"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 80,
      "functions": 80,
      "lines": 80,
      "statements": 80
    }
  }
}
